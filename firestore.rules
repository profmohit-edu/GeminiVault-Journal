rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default Deny: Disallow all unauthenticated or unmatched access across the database
    match /{document=**} {
      allow read, write: if false;
    }

    // Isolated User Boundary: Users can only access their own user document and subcollections
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Journal documents scoped strictly to the authenticated owner's UID
      match /journals/{journalId} {
        allow read, write, delete: if request.auth != null && request.auth.uid == userId;

        // Messages child collection scoped strictly to the authenticated owner's UID
        match /messages/{messageId} {
          allow read, write, delete: if request.auth != null && request.auth.uid == userId;
        }
      }

      // User-scoped longitudinal insights (e.g. Evolution Intelligence)
      match /insights/{insightId} {
        allow read, write, delete: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
