# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# In production on Google Cloud Run, this can also be resolved via Secret Manager.
GEMINI_API_KEY=""

# Optional: Google Cloud Secret Manager secret resource name or ID (for production Cloud Run deployments)
# e.g. projects/PROJECT_ID/secrets/gemini-api-key/versions/latest
GEMINI_SECRET_NAME=""

# GOOGLE_CLOUD_PROJECT: Target Google Cloud Project ID
GOOGLE_CLOUD_PROJECT=""

# APP_URL: The URL where this applet is hosted.
APP_URL=""

